# Names only: populate the appropriate cloud service dashboard, never this file.
# Render common / automatically wired by render.yaml.
# Profiles: render for Discovery/Gateway; render,tidb for the four DB services.
SPRING_PROFILES_ACTIVE=
PORT=
SERVICE=
SERVICE_HOSTNAME=
DISCOVERY_HOSTPORT=
JWT_ISSUER=
# Auth service only (private key is never shared with other services)
AUTH_DB_URL=
AUTH_DB_USER=
AUTH_DB_PASSWORD=
JWT_PRIVATE_KEY=
# Patient service only
PATIENT_DB_URL=
PATIENT_DB_USER=
PATIENT_DB_PASSWORD=
# Doctor service only
DOCTOR_DB_URL=
DOCTOR_DB_USER=
DOCTOR_DB_PASSWORD=
# Appointment service only
APPOINTMENT_DB_URL=
APPOINTMENT_DB_USER=
APPOINTMENT_DB_PASSWORD=
# All four database services: public RSA key as mounted PEM (TiDB uses JVM CA roots)
JWT_PUBLIC_KEY=
# Optional ONLY for a custom provider CA; not required for standard TiDB Starter TLS
MYSQL_CA_CERT=
MYSQL_TRUSTSTORE_PASSWORD=
# Optional, exported by the entrypoint only when MYSQL_CA_CERT is supplied
MYSQL_TRUSTSTORE_URL=
# Optional JVM tuning; the image supplies a bounded default
JAVA_TOOL_OPTIONS=
# Netlify build environment only; public HTTPS gateway origin, no secrets
API_GATEWAY_ORIGIN=
